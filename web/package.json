    "start": "next start",
    "serve:static": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "24.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "playwright-core": "^1.62.1",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.2"
  }
}
