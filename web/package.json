{
  "name": "jcx-proptech-intelligence-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "JCX Global PropTech Intelligence Atlas — public analysis experience built from the 2026-08-30 research corpus.",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "verify": "node scripts/verify-content.mjs",
